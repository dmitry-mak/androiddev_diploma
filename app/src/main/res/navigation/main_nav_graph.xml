<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/postsFragment">

    <fragment
        android:id="@+id/postsFragment"
        android:name="ru.netology.nework.ui.posts.PostsFragment"
        android:label="Posts">
        <action
            android:id="@+id/action_postsFragment_to_createPostFragment"
            app:destination="@id/createPostFragment" />
    </fragment>

    <fragment
        android:id="@+id/eventsFragment"
        android:name="ru.netology.nework.ui.events.EventsFragment"
        android:label="Events" />
    <fragment
        android:id="@+id/usersFragment"
        android:name="ru.netology.nework.ui.users.UsersFragment"
        android:label="Users" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="ru.netology.nework.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@+id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="ru.netology.nework.ui.auth.RegisterFragment"
        android:label="Register" />

    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@+id/loginFragment" />

    <action
        android:id="@+id/action_global_registerFragment"
        app:destination="@+id/registerFragment" />

    <fragment
        android:id="@+id/createPostFragment"
        android:name="ru.netology.nework.ui.posts.CreatePostFragment"
        android:label="New post">
        <argument
            android:name="postId"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

</navigation>